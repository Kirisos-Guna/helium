+bool CanUseTransparentWebContents(const views::View* view) {
+  const views::Widget* widget = view ? view->GetWidget() : nullptr;
+  const BrowserView* browser_view =
+      widget ? BrowserView::GetBrowserViewForNativeWindow(
+                   widget->GetNativeWindow())
+             : nullptr;
+  return features::HeliumNativeFrameAvailable() && browser_view &&
+         !browser_view->GetIsWebAppType();
+}
+
+bool ShouldUseTransparentWebContents(const BrowserView* browser_view) {
+  return ShouldUseNativeFrameMaterials(browser_view) &&
+         browser_view->GetProfile()->GetPrefs()->GetBoolean(
+             prefs::kHeliumTransparentWebContents);
+}
+
+bool ShouldUseTransparentWebContents(const BrowserWindowInterface* browser) {
+  return ShouldUseTransparentWebContents(
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr);
+}
+
+bool ShouldUseTransparentWebContents(const views::View* view) {
+  const views::Widget* widget = view ? view->GetWidget() : nullptr;
+  return ShouldUseTransparentWebContents(
+      widget ? BrowserView::GetBrowserViewForNativeWindow(
+                   widget->GetNativeWindow())
+             : nullptr);
+}
